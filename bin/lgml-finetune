#!/usr/bin/env lua5.4
-- lgml-finetune: train a LoRA adapter on a JSONL chat or text dataset.

local root = ((arg and arg[0] or ""):match("^(.*)/[^/]*$") or ".") .. "/.."
package.path = root .. "/lua/?.lua;" .. root .. "/lua/?/init.lua;" ..
    root .. "/lua_modules/share/lua/5.4/?.lua;" .. package.path
package.cpath = root .. "/" .. (os.getenv("LGML_BUILD") or "build") .. "/?.so;" .. root .. "/lua_modules/lib/lua/5.4/?.so;" ..
    package.cpath
require("lgml.strict").on()

local lgml = require("lgml")
local getopt = require("lgml.getopt")
local chat = require("lgml.chat")
local tokenizer = require("lgml.tokenizer")
local transformer = require("lgml.transformer")
local lora = require("lgml.lora")
local finetune = require("lgml.finetune")
local placement = require("lgml.placement")

local USAGE = [[
usage: lgml-finetune [-h] -m model -d data [-o out] [-b backend] [-t n] [-r rank]
                     [--alpha a] [--targets list] [--layers list] [--lr x]
                     [--warmup n] [--wd x] [--optimizer name] [-e epochs] [-c ctx]
                     [--schedule name] [--min-lr x] [--steps n]
                     [--batch n] [--grad-accum n] [--eval file]
                     [--eval-split f] [--eval-every n] [--save-every n]
                     [--init adapter] [--seed n] [--think] [--format name]
                     [--recompute] [--override-tensor pattern=backend]
                     [--clip x] [--no-shuffle]
  -m, --model file     base gguf model: a dense llama or qwen3, or a
                       qwen35 hybrid; its weights may be quantized
  -d, --data file      JSONL training data, one object per line:
                       {"messages": [...]} in OpenAI chat form, with the
                       loss on the assistant turns only, or {"text": "..."}
                       with the loss on every token
      --format name    chat: lines hold messages or text (default);
                       text: every line holds text, such as a source
                       file with a "/* file: path */" first line; text
                       longer than the context splits into chunks
  -o, --out file       adapter gguf to write (default adapter.gguf); it
                       loads in llama.cpp with --lora
  -b, --backend name   ggml backend, for example Vulkan0 or CPU (default
                       best)
  -t, --threads n      CPU threads (default: LGML_THREADS, else the
                       physical cores)
  -r, --rank n         LoRA rank (default 8)
      --alpha a        LoRA alpha; the scale is alpha / rank (default
                       2 * rank)
      --targets list   comma-separated weights to adapt (default
                       attn_q,attn_k,attn_v,attn_output,attn_qkv,
                       attn_gate,ssm_in,ssm_out,ffn_gate,ffn_up,
                       ffn_down); "output" adds the output
                       projection
      --layers list    blocks to adapt, as gguf numbers them from 0:
                       comma-separated numbers and ranges, such as 0-59
                       (default all)
      --lr x           learning rate (default 1e-4)
      --warmup n       steps of linear learning rate warmup (default 0)
      --schedule name  constant, or cosine: after the warmup the rate
                       falls to --min-lr at the last step (default
                       constant)
      --min-lr x       the last rate of cosine (default 0)
      --steps n        stop after n optimizer steps; cosine ends there
                       (default: all the epochs)
      --wd x           weight decay (default 0)
      --clip x         clip the global gradient norm to x; 0 for none
                       (default 1)
      --optimizer name adamw or sgd (default adamw)
      --no-shuffle     train in the order of the data file, for a
                       curriculum; --eval-split still takes the last
                       samples
  -e, --epochs n       passes over the data (default 1)
  -c, --ctx n          the most tokens in one micro-batch; longer
                       samples lose their end (default 512)
      --batch n        the most samples packed in one micro-batch
                       (default: as many as fit in ctx)
      --grad-accum n   micro-batches in one optimizer step (default 1)
      --eval file      JSONL eval data
      --eval-split f   hold out this fraction of the data for eval
                       (default 0)
      --eval-every n   eval every n steps (default: after each epoch)
      --save-every n   write a checkpoint every n steps, to the out
                       file with -stepN before .gguf (default 0: off)
      --init adapter   start from this adapter (gguf or PEFT)
      --seed n         seed for the adapter and the order (default 1)
      --think          render the chat template with thinking on
      --recompute      backward pass one layer at a time: a third more
                       time, a fraction of the device memory
      --override-tensor pattern=backend
                       put the weights whose names match a Lua pattern
                       on backend: CPU, or any other name for the -b
                       backend; repeat for more (default on a GPU: the
                       token embeddings in host memory, when the model
                       has its own output weight)
  -h, --help           show this help
]]

local function die(msg)
	io.stderr:write("lgml-finetune: ", msg, "\n")
	os.exit(1)
end

local function num(opts, k, def, int)
	local v = opts[k]
	if v == nil then
		return def
	end
	local n = tonumber(v)
	if not n or (int and not math.tointeger(n)) then
		die(("bad value for %s: %s"):format(k, v))
	end
	return int and math.tointeger(n) or n
end

local function main(args)
	local opts, rest = getopt.parse(args, "hm:d:o:b:t:r:e:c:", {
		help = "h", model = "m", data = "d", out = "o", backend = "b", threads = "t", rank = "r",
		epochs = "e", ctx = "c", ["alpha="] = false, ["targets="] = false, ["layers="] = false, ["lr="] = false,
		["warmup="] = false, ["wd="] = false, ["optimizer="] = false, ["batch="] = false,
		["schedule="] = false, ["min-lr="] = false, ["steps="] = false,
		["grad-accum="] = false, ["eval="] = false, ["eval-split="] = false,
		["eval-every="] = false, ["save-every="] = false, ["init="] = false,
		["seed="] = false, think = false, ["format="] = false, recompute = false,
		["override-tensor="] = false, ["clip="] = false,
		["no-shuffle"] = false,
	}, { ["override-tensor"] = true })
	if not opts then
		io.stderr:write("lgml-finetune: ", rest, "\n", USAGE)
		os.exit(2)
	end
	if opts.h then
		io.stdout:write(USAGE)
		return
	end
	if #rest > 0 or not opts.m or not opts.d then
		io.stderr:write(USAGE)
		os.exit(2)
	end
	local out = opts.o or "adapter.gguf"
	local rank = num(opts, "r", 8, true)
	local ctx = num(opts, "c", 512, true)
	local split = num(opts, "eval-split", 0)
	local seed = num(opts, "seed", 1, true)
	local threads = num(opts, "t", nil, true)
	local optimizer = opts.optimizer or "adamw"
	local format = opts.format or "chat"
	if format ~= "chat" and format ~= "text" then
		die("format must be chat or text")
	end
	if opts.schedule and opts.schedule ~= "constant" and opts.schedule ~= "cosine" then
		die("schedule must be constant or cosine")
	end
	if optimizer ~= "adamw" and optimizer ~= "sgd" then
		die("optimizer must be adamw or sgd")
	end
	if rank < 1 or ctx < 2 or split < 0 or split >= 1 or (threads and threads < 1) then
		die("rank, ctx, threads or eval split out of range")
	end

	local info = assert(lgml.gguf(opts.m))
	local untied = false
	for _, t in ipairs(info.tensors) do
		untied = untied or t.name == "output.weight"
	end
	-- Only get_rows reads the token embeddings, so host memory costs
	-- little time and frees device memory.
	local ot = opts["override-tensor"]
	if not ot and untied and (opts.b or ""):upper() ~= "CPU" then
		ot = { "^token_embd%.weight$=CPU" }
	end
	local good_rules, rules = pcall(placement.rules, { override = ot })
	if not good_rules then
		die(tostring(rules))
	end
	local be = assert(lgml.backend(opts.b, { threads = threads, cpu = rules ~= nil }))
	if be:name():upper():match("^CPU") then
		rules = nil
	end
	-- Text data needs no chat template.
	local family
	local function chat_family()
		if not family then
			local good, f = pcall(chat.load, info.meta)
			if not good then
				die(tostring(f))
			end
			family = f
		end
		return family
	end
	local tk = assert(tokenizer.open(opts.m))
	local model = transformer.load(be, opts.m, { placement = rules })
	local ok, err = pcall(finetune.check, model)
	if not ok then
		die(tostring(err))
	end

	local function samples(path)
		local list = {}
		local good, recs = pcall(finetune.read_jsonl, path, format)
		if not good then
			die(tostring(recs))
		end
		for _, r in ipairs(recs) do
			local ss = r.text and finetune.encode_text(tk, r.text, ctx) or
			    finetune.encode(tk, chat_family(), r.messages, { enable_thinking = opts.think })
			for _, s in ipairs(ss) do
				list[#list + 1] = s
			end
		end
		return list
	end
	local train = samples(opts.d)
	local eval = opts.eval and samples(opts.eval) or {}
	if split > 0 then
		local k = math.max(1, math.floor(#train * split + 0.5))
		for _ = 1, k do
			eval[#eval + 1] = table.remove(train)
		end
	end
	local batch = num(opts, "batch", nil, true)
	if model.recurrent then
		-- The recurrent state would carry from one sample to the next.
		batch = 1
	end
	local tmb, trimmed = finetune.pack(train, ctx, batch)
	local emb = finetune.pack(eval, ctx, batch)
	if trimmed > 0 then
		io.stderr:write(("lgml-finetune: %d samples longer than %d tokens lose their end\n"):format(
		    trimmed, ctx))
	end
	if #tmb == 0 then
		die(opts.d .. ": no sample has loss tokens")
	end

	local ad
	if opts.init then
		ad = lora.load(model, opts.init)
		for _, p in ipairs(ad:params()) do
			p:requires_grad()
		end
	else
		local targets
		if opts.targets then
			targets = {}
			for t in opts.targets:gmatch("[^,%s]+") do
				targets[#targets + 1] = t
			end
		end
		local layers
		if opts.layers then
			layers = {}
			for part in opts.layers:gmatch("[^,%s]+") do
				local lo, hi = part:match("^(%d+)%-(%d+)$")
				lo, hi = tonumber(lo or part), tonumber(hi or part)
				if not (lo and hi and math.tointeger(lo) and math.tointeger(hi)) or lo > hi or
				    lo < 0 or hi >= #model.layers then
					die(("bad layers: %s; blocks run from 0 to %d"):format(part, #model.layers - 1))
				end
				for il = lo, hi do
					layers[#layers + 1] = il + 1
				end
			end
		end
		ad = lora.new(model, { rank = rank, alpha = num(opts, "alpha", 2 * rank), targets = targets,
		    layers = layers, seed = seed })
	end
	local m = 0
	for _, mb in ipairs(tmb) do
		m = m + mb.m
	end
	io.stderr:write(("lgml-finetune: %s on %s; %d adapter weights, %d values; %d micro-batches, " ..
	    "%d loss tokens; eval %d micro-batches\n"):format(model.hp.arch, be:name(), #ad.names,
	    ad:numel(), #tmb, m, #emb))

	local base = out:gsub("%.gguf$", "")
	local function save(path)
		local good, serr = ad:save(path, { ["general.name"] = info.meta["general.name"] or "lgml" })
		if not good then
			die(path .. ": " .. tostring(serr))
		end
	end
	local t0 = lgml.clock()
	local res = finetune.train({
		model = model, adapter = ad, train = tmb, eval = emb,
		epochs = num(opts, "e", 1, true), accum = num(opts, "grad-accum", 1, true),
		lr = num(opts, "lr", 1e-4), warmup = num(opts, "warmup", 0, true),
		schedule = opts.schedule, min_lr = num(opts, "min-lr", 0), steps = num(opts, "steps", nil, true),
		weight_decay = num(opts, "wd", 0), optimizer = optimizer, seed = seed,
		eval_every = num(opts, "eval-every", nil, true), recompute = opts.recompute,
		shuffle = not opts["no-shuffle"],
		clip = num(opts, "clip", 1) > 0 and num(opts, "clip", 1) or nil,
		save_every = num(opts, "save-every", 0, true),
		save = function(step)
			save(("%s-step%d.gguf"):format(base, step))
		end,
		log = function(ev)
			if ev.kind == "step" then
				io.stdout:write(("step %d epoch %d loss %.4f lr %.3g tokens %d %.1fs%s\n"):format(
				    ev.step, ev.epoch, ev.loss, ev.lr, ev.tokens, ev.seconds,
				    ev.grad_norm and (" gnorm %.3f"):format(ev.grad_norm) or ""))
			else
				io.stdout:write(("eval step %d loss %.4f\n"):format(ev.step, ev.loss))
			end
			io.stdout:flush()
		end,
	})
	save(out)
	io.stderr:write(("lgml-finetune: %d steps in %.1fs; wrote %s\n"):format(res.steps,
	    lgml.clock() - t0, out))
end

main(arg)
