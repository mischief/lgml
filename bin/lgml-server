#!/usr/bin/env lua5.4
-- lgml-server: OpenAI-shaped HTTP server.

local root = ((arg and arg[0] or ""):match("^(.*)/[^/]*$") or ".") .. "/.."
package.path = root .. "/lua/?.lua;" .. root .. "/lua/?/init.lua;" ..
    root .. "/lua_modules/share/lua/5.4/?.lua;" .. package.path
package.cpath = root .. "/" .. (os.getenv("LGML_BUILD") or "build") .. "/?.so;" .. root .. "/lua_modules/lib/lua/5.4/?.so;" ..
    package.cpath
require("lgml.strict").on()

local uv = require("luv")
local getopt = require("lgml.getopt")
local server = require("lgml.server.httpd")
local openai = require("lgml.server.openai")

local USAGE = [=[
usage: lgml-server [-h] [-l addr] [-p port] [--fake] [-C config] [-m model] [-b backend]
                   [-c n_ctx] [--no-fa] [--ctk type] [--ctv type] [--alias id]
                   [--recipe file] [--cache-ram MiB] [--ctx-checkpoints n]
                   [--lora file[:scale]]... [--mmproj file] [--image-min-tokens n]
                   [--image-max-tokens n] [--inproc] [--stt] [--engine module]
                   [--cors origin]
  -l, --listen addr   address to listen on (default 127.0.0.1)
  -p, --port port     port to listen on (default 8080)
  -C, --config file   Lua file returning { listen, port, cors, models = { spec, ... } };
                      spec: { model = path, id, backend, ctx, flash_attn, stt,
                      cache_type_k, cache_type_v, recipe, cache_ram,
                      ctx_checkpoints, lora = "file[:scale]" or a list of
                      them or of { path, scale }, mmproj, image_min_tokens,
                      image_max_tokens,
                      engine = Lua module with new(opts), such as a TTS engine,
                      modes = list of completion, multimodal, decide,
                      transcription, speech, image_generation (default: from
                      the engine and files; needed for other engine modules) }
  -m, --model file    gguf model file, or a Whisper model directory
  -b, --backend name  ggml backend, for example Vulkan0 or CPU (default best)
  -c, --ctx n         context size in tokens (default: the model's)
      --no-fa         use soft_max attention, not flash attention
      --ctk type      K cache type: f16, q8_0, q4_0, ... (default q8_0,
                      or f16 with --no-fa); quantized types need flash
                      attention
      --ctv type      V cache type, as --ctk
      --alias id      model id for /v1/models
      --recipe file   decision recipe for /v1/systemone: a Jevify
                      recipe.json (default: temperature 1, two option
                      orders for choice)
      --cache-ram MiB host RAM for stored prompt prefixes (default 8192;
                      0 turns the store off, -1 means no limit)
      --ctx-checkpoints n
                      state checkpoints per slot for hybrid and sliding
                      window models (default 8; 0 turns them off)
      --lora file[:scale]
                      apply a LoRA adapter (llama.cpp gguf or PEFT
                      directory) with this scale (default 1); repeat for
                      more; a request can change scales with "lora":
                      [{"id": 0, "scale": 0.5}]; GET /lora-adapters
                      lists them
      --mmproj file   vision mmproj gguf (llama.cpp format) for image input
                      in chat messages, as image_url parts with data URLs
      --image-min-tokens n, --image-max-tokens n
                      token range of one image (default: the encoder's;
                      gemma4v: 40 to 280)
      --inproc        run the model in this process, not in a worker
      --stt           the model is speech-to-text (found from config.json
                      when not given)
      --engine module Lua engine module for the model, such as
                      lgml.image.engine with -m a Z-Image directory
      --cors origin   allow cross-origin requests from origin, such as
                      http://localhost:8000 or * (default: none)
      --fake          serve the fake test engine
  -h, --help          show this help
]=]

local function die(msg)
	io.stderr:write("lgml-server: ", msg, "\n")
	os.exit(1)
end

-- Adapters of a spec as { path, scale } entries. spec.lora is
-- "file[:scale]", or a list of those or of { path, scale }.
local function adapters(spec)
	local list = type(spec.lora) == "table" and spec.lora or { spec.lora }
	local out = {}
	for i, a in ipairs(list) do
		local path, scale
		if type(a) == "table" then
			path, scale = a.path or a[1], a.scale or a[2] or 1
		elseif type(a) == "string" then
			path, scale = a:match("^(.*):([^:/]+)$")
			if not (path and tonumber(scale)) then
				path, scale = a, 1
			end
		end
		scale = tonumber(scale)
		if type(path) ~= "string" or not scale then
			die(("bad lora entry %d: %s"):format(i, tostring(a)))
		end
		out[i] = { path = path, scale = scale }
	end
	return out
end

-- One engine from a model spec: { model, id, backend, ctx, flash_attn,
-- stt, inproc }.
local function model_engine(spec)
	local n_ctx = spec.ctx and tonumber(spec.ctx)
	if spec.ctx and not n_ctx then
		die("bad context size " .. tostring(spec.ctx))
	end
	local ram, ckpt = spec.cache_ram and tonumber(spec.cache_ram),
	    spec.ctx_checkpoints and math.tointeger(tonumber(spec.ctx_checkpoints))
	if spec.cache_ram and not ram then
		die("bad cache RAM size " .. tostring(spec.cache_ram))
	end
	if spec.ctx_checkpoints and not (ckpt and ckpt >= 0) then
		die("bad checkpoint count " .. tostring(spec.ctx_checkpoints))
	end
	local detect = require("lgml.detect")
	local stt = not spec.engine and (spec.stt or detect.is_whisper(spec.model))
	local okm, modes = pcall(detect.modes, spec)
	if not okm then
		die(modes)
	end
	local lora = adapters(spec)
	if #lora > 0 and (stt or spec.engine) then
		die("lora needs a chat model")
	end
	local imin, imax = spec.image_min_tokens and math.tointeger(tonumber(spec.image_min_tokens)),
	    spec.image_max_tokens and math.tointeger(tonumber(spec.image_max_tokens))
	if (spec.image_min_tokens and not (imin and imin > 0)) or
	    (spec.image_max_tokens and not (imax and imax >= (imin or 1))) then
		die("bad image token range")
	end
	if spec.inproc and spec.engine then
		return require(spec.engine).new({
			model = spec.model, backend = spec.backend, id = spec.id, n_ctx = n_ctx,
		})
	elseif spec.inproc and stt then
		return require("lgml.stt_engine").new({
			model = spec.model, backend = spec.backend, id = spec.id,
		})
	elseif spec.inproc then
		return require("lgml.engine").new({
			model = spec.model, backend = spec.backend, n_ctx = n_ctx,
			flash_attn = spec.flash_attn ~= false, id = spec.id,
			cache_type_k = spec.cache_type_k, cache_type_v = spec.cache_type_v,
			recipe = spec.recipe, cache_ram = ram, ctx_checkpoints = ckpt, lora = lora,
			mmproj = spec.mmproj, image_min_tokens = imin, image_max_tokens = imax,
		})
	end
	local wargs = { "-m", spec.model }
	for flag, v in pairs({
		["-b"] = spec.backend, ["-c"] = spec.ctx, ["--alias"] = spec.id,
		["--ctk"] = spec.cache_type_k, ["--ctv"] = spec.cache_type_v,
		["--recipe"] = spec.recipe, ["--cache-ram"] = spec.cache_ram,
		["--ctx-checkpoints"] = spec.ctx_checkpoints, ["--mmproj"] = spec.mmproj,
		["--image-min-tokens"] = imin, ["--image-max-tokens"] = imax,
	}) do
		table.move({ flag, tostring(v) }, 1, 2, #wargs + 1, wargs)
	end
	if spec.flash_attn == false then
		wargs[#wargs + 1] = "--no-fa"
	end
	for _, a in ipairs(lora) do
		table.move({ "--lora", ("%s:%.17g"):format(a.path, a.scale) }, 1, 2, #wargs + 1, wargs)
	end
	if stt then
		wargs[#wargs + 1] = "--stt"
	end
	if spec.engine then
		table.move({ "--engine", spec.engine }, 1, 2, #wargs + 1, wargs)
	end
	return require("lgml.server.remote_engine").new({
		lua = arg[-1] or "lua5.4", script = root .. "/bin/lgml-worker", args = wargs,
		modes = modes,
	})
end

-- A config file is Lua that returns { models = { spec, ... } }.
local function config_engine(path, inproc)
	local chunk, err = loadfile(path, "t", {})
	if not chunk then
		die(err)
	end
	local ok, cfg = pcall(chunk)
	if not ok or type(cfg) ~= "table" or type(cfg.models) ~= "table" or #cfg.models == 0 then
		die(path .. ": must return { models = { ... } }")
	end
	local engines = {}
	for i, spec in ipairs(cfg.models) do
		if type(spec.model) ~= "string" then
			die(("%s: models[%d].model must be a path"):format(path, i))
		end
		spec.inproc = spec.inproc or inproc
		engines[i] = model_engine(spec)
	end
	return require("lgml.server.router").new(engines), cfg
end

local function make_engine(opts)
	if opts.fake then
		return require("lgml.server.fake_engine").new({ delay = 30 })
	end
	if opts.C then
		return config_engine(opts.C, opts.inproc)
	end
	if opts.m then
		return model_engine({
			model = opts.m, id = opts.alias, backend = opts.b, ctx = opts.c,
			flash_attn = not opts["no-fa"], stt = opts.stt, inproc = opts.inproc,
			cache_type_k = opts.ctk, cache_type_v = opts.ctv, recipe = opts.recipe,
			cache_ram = opts["cache-ram"], ctx_checkpoints = opts["ctx-checkpoints"],
			engine = opts.engine, lora = opts.lora, mmproj = opts.mmproj,
			image_min_tokens = opts["image-min-tokens"],
			image_max_tokens = opts["image-max-tokens"],
		})
	end
	die("no engine: give -m model, -C config or --fake")
end

local function main(args)
	local opts, rest = getopt.parse(args, "hl:p:m:b:c:C:", {
		config = "C", help = "h", listen = "l", port = "p", model = "m", backend = "b",
		ctx = "c", fake = false, ["no-fa"] = false, ["alias="] = false,
		inproc = false, stt = false, ["ctk="] = false, ["ctv="] = false, ["engine="] = false,
		["recipe="] = false, ["cache-ram="] = false, ["ctx-checkpoints="] = false,
		["lora="] = false, ["cors="] = false,
		["mmproj="] = false, ["image-min-tokens="] = false, ["image-max-tokens="] = false,
	}, { lora = true })
	if not opts then
		io.stderr:write("lgml-server: ", rest, "\n", USAGE)
		os.exit(2)
	end
	if opts.h then
		io.stdout:write(USAGE)
		return
	end
	if #rest > 0 then
		io.stderr:write(USAGE)
		os.exit(2)
	end
	local engine, cfg = make_engine(opts)
	cfg = cfg or {}
	local port = math.tointeger(tonumber(opts.p or cfg.port or 8080))
	if not port or port < 0 or port > 65535 then
		die("bad port " .. tostring(opts.p or cfg.port))
	end
	local srv = server.new({ cors = opts.cors or cfg.cors })
	openai.install(srv, engine)
	local bound, err = srv:listen(opts.l or cfg.listen or "127.0.0.1", port)
	if not bound then
		if engine.stop then
			engine:stop()
		end
		die("listen: " .. tostring(err))
	end
	io.stderr:write(("lgml-server: listening on %s:%d\n"):format(srv.host,
	    bound))
	local sigs
	local function stop()
		if engine.stop then
			engine:stop()
		end
		srv:close()
		for _, s in ipairs(sigs) do
			s:close()
		end
		uv.stop()
	end
	sigs = {}
	for i, name in ipairs({ "sigint", "sigterm" }) do
		sigs[i] = uv.new_signal()
		sigs[i]:start(name, stop)
	end
	uv.run()
end

main(arg)
