#!/usr/bin/env lua5.4
-- lgml-server: OpenAI-shaped HTTP server.

local root = ((arg and arg[0] or ""):match("^(.*)/[^/]*$") or ".") .. "/.."
package.path = root .. "/lua/?.lua;" .. root .. "/lua/?/init.lua;" ..
    root .. "/lua_modules/share/lua/5.4/?.lua;" .. package.path
package.cpath = root .. "/" .. (os.getenv("LGML_BUILD") or "build") .. "/?.so;" .. root .. "/lua_modules/lib/lua/5.4/?.so;" ..
    package.cpath
require("lgml.strict").on()

local uv = require("luv")
local getopt = require("lgml.getopt")
local server = require("lgml.server.httpd")
local openai = require("lgml.server.openai")
local log = require("lgml.log")

local L = log.new("server")

local USAGE = [=[
usage: lgml-server [-h] [-l addr] [-p port] [--fake] [-C config] [-m model] [-b backend]
                   [-t threads] [-c n_ctx] [--no-fa] [--ctk type] [--ctv type] [--alias id]
                   [--recipe file] [--cache-ram MiB] [--ctx-checkpoints n]
                   [--lora file[:scale]]... [--mmproj file] [--image-min-tokens n]
                   [--image-max-tokens n] [--inproc] [--stt] [--engine module]
                   [--text-backend name] [--cors origin] [--vram MiB] [--idle seconds]
                   [-v]... [--log-level name] [--log-file path] [--dump-prompts dir]
                   [--state-dir dir] [--unknown-fields rule]
  -l, --listen addr   address to listen on (default 127.0.0.1)
  -p, --port port     port to listen on (default 8080)
  -C, --config file   Lua file returning { listen, port, cors, vram, ram, idle,
                      load_wait, threads, log_level, log_file, dump_prompts,
                      state_dir, unknown_fields, models = { spec, ... } };
                      each model runs in its own worker, which starts on the
                      first request for the model; when a load does not fit
                      the budget, idle models unload, least recently used
                      first; vram and ram are MiB budgets for GPU and CPU
                      models (default vram: free GPU memory at startup minus
                      1024; ram: no limit); idle unloads a model after that
                      many seconds without requests (default 0: off);
                      load_wait is the most seconds a load waits for other
                      models' requests to end (default 60), then it fails
                      with 503; POST /models/load and /models/unload with
                      {"model": id} load and unload a model now;
                      spec: { model = path, id, backend, threads, ctx,
                      flash_attn, stt, cache_type_k, cache_type_v, recipe,
                      cache_ram, ctx_checkpoints, lora = "file[:scale]" or a
                      list of them or of { path, scale }, mmproj,
                      image_min_tokens, image_max_tokens,
                      text_backend = backend of the text encoder of
                      lgml.image.engine, such as CPU; its part counts
                      against the budget of that backend,
                      engine = Lua module with new(opts), such as a TTS engine,
                      modes = list of completion, multimodal, decide,
                      transcription, speech, image_generation (default: from
                      the engine and files; needed for other engine modules),
                      preload = true to load at startup, idle = seconds for
                      this model, mem = MiB the model takes on backend
                      (default: an estimate from its files and KV cache
                      plus 1024, then the measure of its worker) }
  -m, --model file    gguf model file, or a Whisper model directory
  -b, --backend name  ggml backend, for example Vulkan0 or CPU (default best)
  -t, --threads n     CPU threads of each model (default: LGML_THREADS, else
                      the physical cores); with -C it overrides threads, and
                      a threads key in a model spec overrides both
  -c, --ctx n         context size in tokens (default: the model's)
      --no-fa         use soft_max attention, not flash attention
      --ctk type      K cache type: f16, q8_0, q4_0, ... (default q8_0,
                      or f16 with --no-fa); quantized types need flash
                      attention
      --ctv type      V cache type, as --ctk
      --alias id      model id for /v1/models
      --recipe file   decision recipe for /v1/systemone: a Jevify
                      recipe.json (default: temperature 1, two option
                      orders for choice)
      --cache-ram MiB host RAM for stored prompt prefixes (default 8192;
                      0 turns the store off, -1 means no limit)
      --ctx-checkpoints n
                      state checkpoints per slot for hybrid and sliding
                      window models (default 8; 0 turns them off)
      --lora file[:scale]
                      apply a LoRA adapter (llama.cpp gguf or PEFT
                      directory) with this scale (default 1); repeat for
                      more; a request can change scales with "lora":
                      [{"id": 0, "scale": 0.5}]; GET /lora-adapters
                      lists them
      --mmproj file   vision mmproj gguf (llama.cpp format) for image input
                      in chat messages, as image_url parts with data URLs,
                      and in /v1/systemone "attachments" (data URLs)
      --image-min-tokens n, --image-max-tokens n
                      token range of one image (default: the encoder's;
                      gemma4v: 40 to 280)
      --inproc        run the model in this process, not in a worker
      --stt           the model is speech-to-text (found from config.json
                      when not given)
      --engine module Lua engine module for the model, such as
                      lgml.image.engine with -m a Z-Image directory
      --text-backend name
                      with --engine lgml.image.engine: the backend of the
                      text encoder, such as CPU (default: the -b backend)
      --cors origin   allow cross-origin requests from origin, such as
                      http://localhost:8000 or * (default: none)
      --vram MiB      with -C: the GPU memory budget (overrides vram)
      --idle seconds  with -C: unload a model after this many seconds
                      without requests (overrides idle)
  -v, --verbose       log more: -v is debug, -vv is trace (default level:
                      log_level of the config, else LGML_LOG, else info)
      --log-level name
                      error, warn, info, debug or trace; info logs one
                      access line per request and model loads; debug adds
                      routing, budgets, request bodies and the rendered
                      prompts; trace adds each token and graph replay
      --log-file path append log lines to path, not stderr; SIGHUP opens
                      it again
      --dump-prompts dir
                      write each rendered chat and decision prompt to
                      dir/<request id>.<kind>.txt
      --state-dir dir directory of state files, such as signing.key, the
                      key of the reasoning signatures of /v1/messages and
                      /v1/responses (default $XDG_STATE_HOME/lgml, else
                      ~/.local/state/lgml)
      --unknown-fields rule
                      reject (default) or ignore: an unknown field of a
                      /v1/messages or /v1/responses request gives 400, or
                      is ignored and named in the x-lgml-ignored header
      --fake          serve the fake test engine
  -h, --help          show this help
]=]

local function die(msg)
	io.stderr:write("lgml-server: ", msg, "\n")
	os.exit(1)
end

-- Adapters of a spec as { path, scale } entries. spec.lora is
-- "file[:scale]", or a list of those or of { path, scale }.
local function adapters(spec)
	local list = type(spec.lora) == "table" and spec.lora or { spec.lora }
	local out = {}
	for i, a in ipairs(list) do
		local path, scale
		if type(a) == "table" then
			path, scale = a.path or a[1], a.scale or a[2] or 1
		elseif type(a) == "string" then
			path, scale = a:match("^(.*):([^:/]+)$")
			if not (path and tonumber(scale)) then
				path, scale = a, 1
			end
		end
		scale = tonumber(scale)
		if type(path) ~= "string" or not scale then
			die(("bad lora entry %d: %s"):format(i, tostring(a)))
		end
		out[i] = { path = path, scale = scale }
	end
	return out
end

-- One engine from a model spec: { model, id, backend, threads, ctx,
-- flash_attn, stt, inproc }. With managed, the spec becomes a model of
-- the pool that loads on demand: managed(spec, modes, start) adds it,
-- and start(options) starts its worker.
local function model_engine(spec, managed)
	local n_ctx = spec.ctx and tonumber(spec.ctx)
	if spec.ctx and not n_ctx then
		die("bad context size " .. tostring(spec.ctx))
	end
	local ram, ckpt = spec.cache_ram and tonumber(spec.cache_ram),
	    spec.ctx_checkpoints and math.tointeger(tonumber(spec.ctx_checkpoints))
	if spec.cache_ram and not ram then
		die("bad cache RAM size " .. tostring(spec.cache_ram))
	end
	if spec.ctx_checkpoints and not (ckpt and ckpt >= 0) then
		die("bad checkpoint count " .. tostring(spec.ctx_checkpoints))
	end
	local threads = spec.threads and math.tointeger(tonumber(spec.threads))
	if spec.threads and not (threads and threads >= 1 and threads <= 1024) then
		die("bad thread count " .. tostring(spec.threads))
	end
	local detect = require("lgml.detect")
	local stt = not spec.engine and (spec.stt or detect.is_whisper(spec.model))
	local okm, modes = pcall(detect.modes, spec)
	if not okm then
		die(modes)
	end
	local lora = adapters(spec)
	if #lora > 0 and (stt or spec.engine) then
		die("lora needs a chat model")
	end
	local imin, imax = spec.image_min_tokens and math.tointeger(tonumber(spec.image_min_tokens)),
	    spec.image_max_tokens and math.tointeger(tonumber(spec.image_max_tokens))
	if (spec.image_min_tokens and not (imin and imin > 0)) or
	    (spec.image_max_tokens and not (imax and imax >= (imin or 1))) then
		die("bad image token range")
	end
	if spec.text_backend and spec.engine ~= "lgml.image.engine" then
		die("text_backend needs engine lgml.image.engine")
	end
	if spec.inproc and spec.engine then
		return require(spec.engine).new({
			model = spec.model, backend = spec.backend, text_backend = spec.text_backend,
			threads = threads, id = spec.id, n_ctx = n_ctx,
		})
	elseif spec.inproc and stt then
		return require("lgml.stt_engine").new({
			model = spec.model, backend = spec.backend, threads = threads, id = spec.id,
		})
	elseif spec.inproc then
		return require("lgml.engine").new({
			model = spec.model, backend = spec.backend, threads = threads, n_ctx = n_ctx,
			flash_attn = spec.flash_attn ~= false, id = spec.id,
			cache_type_k = spec.cache_type_k, cache_type_v = spec.cache_type_v,
			recipe = spec.recipe, cache_ram = ram, ctx_checkpoints = ckpt, lora = lora,
			mmproj = spec.mmproj, image_min_tokens = imin, image_max_tokens = imax,
		})
	end
	local wargs = { "-m", spec.model }
	for flag, v in pairs({
		["-b"] = spec.backend, ["-t"] = threads, ["-c"] = spec.ctx, ["--alias"] = spec.id,
		["--text-backend"] = spec.text_backend,
		["--ctk"] = spec.cache_type_k, ["--ctv"] = spec.cache_type_v,
		["--recipe"] = spec.recipe, ["--cache-ram"] = spec.cache_ram,
		["--ctx-checkpoints"] = spec.ctx_checkpoints, ["--mmproj"] = spec.mmproj,
		["--image-min-tokens"] = imin, ["--image-max-tokens"] = imax,
	}) do
		table.move({ flag, tostring(v) }, 1, 2, #wargs + 1, wargs)
	end
	if spec.flash_attn == false then
		wargs[#wargs + 1] = "--no-fa"
	end
	for _, a in ipairs(lora) do
		table.move({ "--lora", ("%s:%.17g"):format(a.path, a.scale) }, 1, 2, #wargs + 1, wargs)
	end
	if stt then
		wargs[#wargs + 1] = "--stt"
	end
	if spec.engine then
		table.move({ "--engine", spec.engine }, 1, 2, #wargs + 1, wargs)
	end
	local function start(o)
		return require("lgml.server.remote_engine").new({
			lua = arg[-1] or "lua5.4", script = root .. "/bin/lgml-worker", args = wargs, id = spec.id,
			modes = modes, restart = o.restart, on_exit = o.on_exit,
		})
	end
	if managed then
		return managed(spec, modes, lora, start)
	end
	return start({})
end

local MiB = 1048576
-- Device memory kept out of the default budget.
local VRAM_RESERVE = 1024 * MiB

local function shell_quote(s)
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

-- The ggml devices, from a worker process, so this process does not
-- start the Vulkan backend.
local function devices()
	local p = io.popen(("%s %s --devices 2>/dev/null"):format(shell_quote(arg[-1] or "lua5.4"),
	    shell_quote(root .. "/bin/lgml-worker")))
	local out = p and p:read("a")
	if p then
		p:close()
	end
	local list = out and require("lgml.json").decode(out)
	return type(list) == "table" and list or {}
end

local function number_key(cfg, key, flag)
	local v = flag or cfg[key]
	if v ~= nil and not tonumber(v) then
		die(("bad %s %s"):format(key, tostring(v)))
	end
	return v and tonumber(v)
end

-- A pool of models that load on demand. The gpu budget is vram, else
-- the free memory of the first GPU at startup minus VRAM_RESERVE.
local function managed_engines(path, cfg, opts)
	local estimate = require("lgml.estimate")
	local seen = {}
	for _, spec in ipairs(cfg.models) do
		spec.id = estimate.id(spec)
		if seen[spec.id] then
			die(("%s: two models have the id %s"):format(path, spec.id))
		end
		seen[spec.id] = true
	end
	local vram = number_key(cfg, "vram", opts.vram)
	local ram = number_key(cfg, "ram")
	local idle = number_key(cfg, "idle", opts.idle)
	local wait = number_key(cfg, "load_wait")
	local gpu
	for _, d in ipairs(devices()) do
		if not gpu and (d.type == "gpu" or d.type == "igpu") then
			gpu = d
		end
	end
	local budget = {
		gpu = vram and vram * MiB or (gpu and math.max(gpu.free - VRAM_RESERVE, 0)) or math.huge,
		cpu = ram and ram * MiB or math.huge,
	}
	local pool = require("lgml.server.pool").new({ budget = budget, idle = idle, load_wait = wait })
	L:info("budget", "gpu", budget.gpu < math.huge and ("%d MiB"):format(budget.gpu // MiB) or "none",
	    "cpu", budget.cpu < math.huge and ("%d MiB"):format(budget.cpu // MiB) or "none",
	    "idle_unload", (idle or 0) > 0 and ("after %g s"):format(idle) or "off")
	local preload = {}
	local kinds, ests = {}, {}
	local function managed(spec, modes, lora, start)
		local kind, est = kinds[spec], ests[spec]
		local mem = number_key(spec, "mem")
		local list = {}
		for i, a in ipairs(lora) do
			list[i] = { id = i - 1, path = a.path, scale = a.scale }
		end
		local m = pool:add({
			id = spec.id, modes = modes, kind = kind,
			size = mem and mem * MiB or est.bytes, fixed = mem ~= nil,
			files = est.files, margin = est.margin, extra = est.extra,
			context_length = est.n_ctx,
			idle = number_key(spec, "idle"),
			props = { n_ctx = est.n_ctx or 0, total_slots = 1, lora = list,
			    modalities = { vision = spec.mmproj ~= nil } },
			start = function(on_exit)
				return start({ restart = false, on_exit = on_exit })
			end,
		})
		local extra = {}
		for k, bytes in pairs(est.extra) do
			extra[#extra + 1] = ("%d MiB %s"):format(bytes // MiB, k)
		end
		L:info("model", "model", m.id, "kind", kind, "size", ("%d MiB"):format(m.size // MiB),
		    "from", mem and "mem" or "estimate", "extra", #extra > 0 and table.concat(extra, ", ") or nil,
		    "preload", spec.preload and true or nil)
		if spec.preload then
			preload[#preload + 1] = m
		end
		return m
	end
	local engines = {}
	for i, spec in ipairs(cfg.models) do
		local kind = estimate.kind(spec.backend, gpu ~= nil)
		local est = estimate.model(spec, budget[kind], gpu ~= nil)
		-- Under a budget, the worker gets the context of the estimate, not
		-- one that fits the free memory at its load.
		if not spec.ctx and est.n_ctx and budget[kind] < math.huge then
			spec.ctx = est.n_ctx
		end
		kinds[spec], ests[spec] = kind, est
		engines[i] = model_engine(spec, managed)
	end
	pool:preload(preload)
	return engines
end

-- A config file is Lua that returns { models = { spec, ... } }.
local function load_config(path)
	local chunk, err = loadfile(path, "t", {})
	if not chunk then
		die(err)
	end
	local ok, cfg = pcall(chunk)
	if not ok or type(cfg) ~= "table" or type(cfg.models) ~= "table" or #cfg.models == 0 then
		die(path .. ": must return { models = { ... } }")
	end
	return cfg
end

local function config_engine(path, cfg, opts)
	local inproc = opts.inproc
	for i, spec in ipairs(cfg.models) do
		if type(spec.model) ~= "string" then
			die(("%s: models[%d].model must be a path"):format(path, i))
		end
		-- The threads of a spec, else --threads, else the threads key.
		if spec.threads == nil then
			spec.threads = opts.t or cfg.threads
		end
	end
	local engines = {}
	if inproc then
		for i, spec in ipairs(cfg.models) do
			spec.inproc = true
			engines[i] = model_engine(spec)
		end
	else
		engines = managed_engines(path, cfg, opts)
	end
	return require("lgml.server.router").new(engines), cfg
end

local function make_engine(opts, cfg)
	if opts.fake then
		return require("lgml.server.fake_engine").new({ delay = 30 })
	end
	if opts.C then
		return config_engine(opts.C, cfg, opts)
	end
	if opts.m then
		return model_engine({
			model = opts.m, id = opts.alias, backend = opts.b, threads = opts.t, ctx = opts.c,
			text_backend = opts["text-backend"],
			flash_attn = not opts["no-fa"], stt = opts.stt, inproc = opts.inproc,
			cache_type_k = opts.ctk, cache_type_v = opts.ctv, recipe = opts.recipe,
			cache_ram = opts["cache-ram"], ctx_checkpoints = opts["ctx-checkpoints"],
			engine = opts.engine, lora = opts.lora, mmproj = opts.mmproj,
			image_min_tokens = opts["image-min-tokens"],
			image_max_tokens = opts["image-max-tokens"],
		})
	end
	die("no engine: give -m model, -C config or --fake")
end

-- The log level: -v or --log-level, else log_level of the config, else
-- LGML_LOG, else info. The log file and the dump directory come from the
-- flag, else the config key.
local function setup_log(opts, cfg)
	local level = opts["log-level"]
	if opts.v then
		level = log.INFO + opts.v
		if level > log.TRACE then
			level = log.TRACE
		end
	end
	level = level or cfg.log_level or os.getenv("LGML_LOG")
	if level then
		local ok, err = log.set_level(level)
		if not ok then
			die(err)
		end
	end
	local file = opts["log-file"] or cfg.log_file
	if file then
		local ok, err = log.open(file)
		if not ok then
			die("log file: " .. tostring(err))
		end
	end
	local dir = opts["dump-prompts"] or cfg.dump_prompts
	if dir then
		local ok, err = uv.fs_stat(dir)
		if not ok or ok.type ~= "directory" then
			die(("dump directory %s: %s"):format(dir, err or "not a directory"))
		end
		log.set_dump_dir(dir)
	end
end

-- The state directory: the flag, the config key, else
-- $XDG_STATE_HOME/lgml or ~/.local/state/lgml. nil when none is known.
local function state_dir(opts, cfg)
	local dir = opts["state-dir"] or cfg.state_dir
	if dir then
		return dir
	end
	local xdg, home = os.getenv("XDG_STATE_HOME"), os.getenv("HOME")
	if xdg and xdg ~= "" then
		return xdg .. "/lgml"
	elseif home and home ~= "" then
		return home .. "/.local/state/lgml"
	end
	return nil
end

local function main(args)
	local opts, rest = getopt.parse(args, "hvl:p:m:b:t:c:C:", {
		config = "C", help = "h", verbose = "v", ["log-level="] = false, ["log-file="] = false,
		["dump-prompts="] = false, listen = "l", port = "p", model = "m", backend = "b",
		threads = "t", ctx = "c", fake = false, ["no-fa"] = false, ["alias="] = false,
		inproc = false, stt = false, ["ctk="] = false, ["ctv="] = false, ["engine="] = false,
		["recipe="] = false, ["cache-ram="] = false, ["ctx-checkpoints="] = false,
		["lora="] = false, ["cors="] = false, ["vram="] = false, ["idle="] = false,
		["mmproj="] = false, ["image-min-tokens="] = false, ["image-max-tokens="] = false,
		["text-backend="] = false, ["state-dir="] = false, ["unknown-fields="] = false,
	}, { lora = true, v = true })
	if not opts then
		io.stderr:write("lgml-server: ", rest, "\n", USAGE)
		os.exit(2)
	end
	if opts.h then
		io.stdout:write(USAGE)
		return
	end
	if #rest > 0 then
		io.stderr:write(USAGE)
		os.exit(2)
	end
	local cfg = opts.C and load_config(opts.C) or {}
	setup_log(opts, cfg)
	local engine = make_engine(opts, cfg)
	local port = math.tointeger(tonumber(opts.p or cfg.port or 8080))
	if not port or port < 0 or port > 65535 then
		die("bad port " .. tostring(opts.p or cfg.port))
	end
	local srv = server.new({ cors = opts.cors or cfg.cors })
	local rule = opts["unknown-fields"] or cfg.unknown_fields
	if rule then
		if rule ~= "reject" and rule ~= "ignore" then
			die("unknown fields: reject or ignore, not " .. tostring(rule))
		end
		require("lgml.server.translate").set_unknown_fields(rule)
	end
	openai.install(srv, engine, { state_dir = state_dir(opts, cfg) })
	local bound, err = srv:listen(opts.l or cfg.listen or "127.0.0.1", port)
	if not bound then
		if engine.stop then
			engine:stop()
		end
		die("listen: " .. tostring(err))
	end
	L:info("listening", "addr", ("%s:%d"):format(srv.host, bound), "log_level", log.level_name())
	local sigs
	local function stop()
		if engine.stop then
			engine:stop()
		end
		srv:close()
		for _, s in ipairs(sigs) do
			s:close()
		end
		uv.stop()
	end
	sigs = {}
	for i, name in ipairs({ "sigint", "sigterm" }) do
		sigs[i] = uv.new_signal()
		sigs[i]:start(name, stop)
	end
	-- SIGHUP opens the log file again, here and in each worker.
	sigs[#sigs + 1] = uv.new_signal()
	sigs[#sigs]:start("sighup", function()
		local ok, err = log.reopen()
		if not ok then
			L:error("log file", "err", err)
		end
		require("lgml.server.remote_engine").signal("sighup")
	end)
	uv.run()
end

main(arg)
