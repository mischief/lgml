#!/usr/bin/env lua5.4
-- lgml-server: OpenAI-shaped HTTP server.

local root = ((arg and arg[0] or ""):match("^(.*)/[^/]*$") or ".") .. "/.."
-- The interpreter is the lowest arg index: a luarocks wrapper puts -e
-- options between it and the script.
local LUA = "lua5.4"
do
	local i = -1
	while arg and arg[i] do
		LUA, i = arg[i], i - 1
	end
end
package.path = root .. "/lua/?.lua;" .. root .. "/lua/?/init.lua;" ..
    root .. "/lua_modules/share/lua/5.4/?.lua;" .. package.path
package.cpath = root .. "/" .. (os.getenv("LGML_BUILD") or "build") .. "/?.so;" .. root .. "/lua_modules/lib/lua/5.4/?.so;" ..
    package.cpath
require("lgml.strict").on()

local uv = require("luv")
local getopt = require("lgml.getopt")
local server = require("lgml.server.httpd")
local openai = require("lgml.server.openai")
local log = require("lgml.log")
local models = require("lgml.server.models")

local L = log.new("server")

local USAGE = [=[
usage: lgml-server [-h] [-l addr] [-p port] [--fake] [-C config] [-m model] [-b backend]
                   [-t threads] [-c n_ctx] [--no-fa] [--ctk type] [--ctv type] [--alias id]
                   [--recipe file] [--cache-ram MiB] [--ctx-checkpoints n]
                   [--kv-initial n] [-np n] [-ub n|auto] [--repeat-stop n]
                   [--reasoning-budget n]
                   [--lora file[:scale]]... [--mmproj file] [--image-min-tokens n]
                   [--image-max-tokens n] [--inproc] [--stt] [--engine module]
                   [--text-backend name] [--cpu-moe] [--n-cpu-moe n|auto]
                   [-ngl n] [-ot pattern=backend]... [--moe-cache MiB|auto]
                   [--moe-cache-profile file] [--cors origin] [--vram MiB]
                   [--idle seconds]
                   [-v]... [--log-level name] [--log-file path] [--dump-prompts dir]
                   [--state-dir dir] [--unknown-fields rule]
  -l, --listen addr   address to listen on (default 127.0.0.1)
  -p, --port port     port to listen on (default 8080)
  -C, --config file   Lua file returning { listen, port, cors, vram, ram, idle,
                      load_wait, threads, mem_margin, repeat_stop_tokens,
                      log_level, log_file, dump_prompts, state_dir,
                      unknown_fields, state_ram,
                      models = { spec, ... } };
                      each model runs in its own worker, which starts on the
                      first request for the model; when a load does not fit
                      the budget, idle models unload, least recently used
                      first; vram and ram are MiB budgets for GPU and CPU
                      models (default vram: free GPU memory at startup minus
                      1024; ram: no limit); idle unloads a model after that
                      many seconds without requests (default 0: off);
                      load_wait is the most seconds a load waits for other
                      models' requests to end (default 60), then it fails
                      with 503; a model or request that does not fit gives
                      507; mem_margin is the MiB of device memory that each
                      worker leaves free (default 256), also a spec key;
                      repeat_stop_tokens is --repeat-stop for each model,
                      also a spec key; a chat worker that exits saves its
                      prompt store for the next worker of the model, and
                      state_ram is the most MiB of saved stores that the
                      server holds (default 4096), oldest out first;
                      under systemd with FileDescriptorStoreMax=, the
                      stores and the listening socket outlive a restart;
                      POST /models/load and /models/unload with
                      {"model": id} load and unload a model now;
                      spec: { model = path, id, backend, threads, ctx,
                      flash_attn, stt, cache_type_k, cache_type_v, recipe,
                      cache_ram, ctx_checkpoints, kv_initial, slots,
                      ubatch, repeat_stop_tokens, reasoning_budget_tokens
                      (--reasoning-budget), speculative = true, false or
                      the most draft tokens (--spec), spec_mtp (--spec-mtp),
                      spec_draft and spec_min_p (the guesses and gate of
                      an MTP head),
                      lora = "file[:scale]" or a
                      list of them or of { path, scale }, mmproj,
                      image_min_tokens, image_max_tokens,
                      text_backend = backend of the text encoder of
                      lgml.image.engine, such as CPU; its part counts
                      against the budget of that backend,
                      image_max_side = the largest image side of
                      lgml.image.engine (default 1024); the worker plans
                      its compute memory for it at load,
                      cpu_moe, n_cpu_moe, n_gpu_layers, override = weights
                      of a chat model on a GPU to keep in host memory, as
                      the flags below; override is a list of
                      "pattern=backend"; that part counts against ram,
                      and n_cpu_moe = "auto" fits the rest in vram,
                      moe_cache = MiB or "auto", moe_cache_max = MiB,
                      moe_cache_profile = file, moe_cache_swap = MiB,
                      moe_cache_halflife = tokens: an adaptive cache of
                      the most used experts in vram (see --moe-cache),
                      moe_cache_zerocopy = true: fixed slots, and the
                      device reads the other experts from pinned host
                      memory over PCIe (needs the lgml ggml patch),
                      sampling = sampler defaults of a chat model, such
                      as { presence_penalty = 1.5 }: temperature, top_k,
                      top_p, min_p, repeat_penalty, repeat_last_n,
                      presence_penalty, frequency_penalty; a request
                      value replaces them,
                      max_tokens = the most tokens of a reply when the
                      request sets none,
                      diffusion = sampler defaults of a block diffusion
                      model such as LLaDA-MoE-v2: { steps, block_length,
                      threshold (false: scheduled), minimal_topk,
                      temperature, prefix_cache },
                      engine = Lua module with new(opts), such as a TTS engine,
                      modes = list of completion, multimodal, decide,
                      transcription, speech, image_generation, embedding
                      (default: from the engine and files, where a gguf
                      with a pooling type is an embedding model; needed
                      for other engine modules),
                      preload = true to load at startup, idle = seconds for
                      this model, mem = MiB the model takes on backend
                      (default: an estimate from its files and KV cache
                      plus 1024, then the sum that its worker reports:
                      weights, KV cache at ctx, planned compute buffers
                      and driver overhead) }
  -m, --model file    gguf model file, or a Whisper model directory
  -b, --backend name  ggml backend, for example Vulkan0 or CPU (default best)
  -t, --threads n     CPU threads of each model (default: LGML_THREADS, else
                      the physical cores); with -C it overrides threads, and
                      a threads key in a model spec overrides both
  -c, --ctx n         context size in tokens (default: the model's)
      --no-fa         use soft_max attention, not flash attention
      --ctk type      K cache type: f16, q8_0, q4_0, ... (default q8_0,
                      or f16 with --no-fa); quantized types need flash
                      attention
      --ctv type      V cache type, as --ctk
      --alias id      model id for /v1/models
      --recipe file   decision recipe for /v1/systemone: a Jevify
                      recipe.json, or "jevify" (the default: temperature
                      1, two option orders for choice) or "nimble" (the
                      prompt and answers of Ollama and Bespoke-Nimble),
                      or "kev" or "clef" (the decision head of a Kev or
                      Clef gguf; such a gguf picks its head by default)
      --cache-ram MiB host RAM for stored prompt prefixes and the state
                      index of hybrid and sliding window models (default
                      8192; 0 turns them off, -1 means no limit)
      --ctx-checkpoints n
                      state checkpoints per slot for hybrid and sliding
                      window models (default 8; 0 turns them off)
      --kv-initial n  KV pool cells at load (default 4096); the pool
                      grows as prompts need, up to -c; 0 allocates all
                      -c cells at load
      --spec n        speculative decoding with prompt lookup drafts of
                      at most n tokens (default 0: off); a request can
                      turn it on or off with "speculative"; a qwen4exp
                      model with an MTP layer drafts with it first
      --spec-mtp file an MTP gguf for the draft head of a qwen4exp model
                      (spec key spec_mtp)
  -np, --parallel n   slots: the most sequences kept (default 4, or
                      fewer when their recurrent states and rings would
                      take more than a quarter of the pool); all
                      slots share one KV pool of -c cells, and -c is
                      also the most tokens of one request; a request
                      takes the slot that shares the longest prefix
                      with its prompt, so clients that take turns keep
                      their caches; an idle slot gives its cells to a
                      running one when the pool is full; with two or
                      more, requests decode together in batched passes
  -ub, --ubatch n|auto
                      prompt tokens per pass (default 512); auto takes
                      the largest of 4096, 2048, 1024 and 512 whose
                      compute buffers fit the memory budget at load
      --repeat-stop n a reply that samples one token n times in a row
                      ends with finish reason length (default 256; 0
                      turns the guard off)
      --reasoning-budget n
                      the reasoning budget of a chat request that sets
                      none: after n reasoning tokens, the engine ends the
                      reasoning block and the model answers (default: no
                      budget)
      --lora file[:scale]
                      apply a LoRA adapter (llama.cpp gguf or PEFT
                      directory) with this scale (default 1); repeat for
                      more; a request can change scales with "lora":
                      [{"id": 0, "scale": 0.5}]; GET /lora-adapters
                      lists them
      --mmproj file   vision mmproj gguf (llama.cpp format) for image input
                      in chat messages, as image_url parts with data URLs,
                      and in /v1/systemone "attachments" (data URLs)
      --image-min-tokens n, --image-max-tokens n
                      token range of one image (default: the encoder's;
                      gemma4v: 40 to 280)
      --inproc        run the model in this process, not in a worker
      --stt           the model is speech-to-text (found from config.json
                      when not given)
      --engine module Lua engine module for the model, such as
                      lgml.image.engine with -m a Z-Image directory, or
                      lgml.laya_engine with -m a Laya decision model
                      directory (/v1/systemone only)
      --text-backend name
                      with --engine lgml.image.engine: the backend of the
                      text encoder, such as CPU (default: the -b backend)
      --cpu-moe       keep the routed expert weights of every layer in
                      host memory; the CPU runs them (llama.cpp --cpu-moe)
      --n-cpu-moe n   the same for the experts of the first n layers; auto
                      picks the fewest layers so the rest fits in free GPU
                      memory, or in vram with -C
      --moe-cache MiB|auto
                      keep every routed expert in host memory, and the
                      most used ones in a GPU cache of MiB that adapts
                      as the model runs; the GPU runs the experts in the
                      cache and the CPU the rest; auto fills the free GPU
                      memory after the KV cache and compute buffers
      --moe-cache-profile file
                      the first expert scores of --moe-cache, from a
                      profile file (see scripts/expert_profile.lua)
      -ngl, --n-gpu-layers n
                      keep the last n layers on the GPU, and the others,
                      the token embeddings and, when n is at most the
                      layer count, the output layer in host memory
      -ot, --override-tensor pattern=backend
                      put the tensors whose names match a Lua pattern
                      (% escapes, no alternation; not a regex),
                      such as exps or blk%.[0-9]%.ffn_, on backend: CPU,
                      or any other name for the -b backend; the first
                      match wins, before --n-cpu-moe and -ngl; repeat, or
                      join entries with commas
      --cors origin   allow cross-origin requests from origin, such as
                      http://localhost:8000 or * (default: none)
      --vram MiB      with -C: the GPU memory budget (overrides vram)
      --idle seconds  with -C: unload a model after this many seconds
                      without requests (overrides idle)
  -v, --verbose       log more: -v is debug, -vv is trace (default level:
                      log_level of the config, else LGML_LOG, else info)
      --log-level name
                      error, warn, info, debug or trace; info logs one
                      access line per request and model loads; debug adds
                      routing, budgets, request bodies and the rendered
                      prompts; trace adds each token and graph replay
      --log-file path append log lines to path, not stderr; SIGHUP opens
                      it again
      --dump-prompts dir
                      write each rendered chat and decision prompt to
                      dir/<request id>.<kind>.txt
      --state-dir dir directory of state files, such as signing.key, the
                      key of the reasoning signatures of /v1/messages and
                      /v1/responses (default $XDG_STATE_HOME/lgml, else
                      ~/.local/state/lgml)
      --unknown-fields rule
                      reject (default) or ignore: an unknown field of a
                      /v1/messages or /v1/responses request gives 400, or
                      is ignored and named in the x-lgml-ignored header
      --fake          serve the fake test engine
  -h, --help          show this help
]=]

local function die(msg)
	io.stderr:write("lgml-server: ", msg, "\n")
	os.exit(1)
end

local MiB = 1048576

-- Saved prompt stores and the listening socket (lgml.server.fdstore),
-- and the store names of the configured models.
local fdstore, state_names = nil, {}

-- Start the worker of a model spec (see lgml.server.models.engine).
local function start_worker(spec, wargs, modes, sname, o)
	return require("lgml.server.remote_engine").new({
		lua = LUA, script = root .. "/bin/lgml-worker", args = wargs, id = spec.id,
		modes = modes, restart = o.restart, on_exit = o.on_exit,
		take_state = function()
			return fdstore and fdstore:take(sname)
		end,
		on_state = function(fd, bytes)
			if fdstore then
				fdstore:put(sname, fd, bytes)
			else
				uv.fs_close(fd)
			end
		end,
	})
end

local function shell_quote(s)
	return "'" .. s:gsub("'", "'\\''") .. "'"
end

-- The ggml devices, from a worker process, so this process does not
-- start the Vulkan backend.
local function devices()
	local p = io.popen(("%s %s --devices 2>/dev/null"):format(shell_quote(LUA),
	    shell_quote(root .. "/bin/lgml-worker")))
	local out = p and p:read("a")
	if p then
		p:close()
	end
	local list = out and require("lgml.json").decode(out)
	return type(list) == "table" and list or {}
end

-- Call f, and end the server with its error.
local function try(f, ...)
	local ok, v = pcall(f, ...)
	if not ok then
		die(v)
	end
	return v
end

-- The log level: -v or --log-level, else log_level of the config, else
-- LGML_LOG, else info. The log file and the dump directory come from the
-- flag, else the config key.
local function setup_log(opts, cfg)
	local level = opts["log-level"]
	if opts.v then
		level = log.INFO + opts.v
		if level > log.TRACE then
			level = log.TRACE
		end
	end
	level = level or cfg.log_level or os.getenv("LGML_LOG")
	if level then
		local ok, err = log.set_level(level)
		if not ok then
			die(err)
		end
	end
	local file = opts["log-file"] or cfg.log_file
	if file then
		local ok, err = log.open(file)
		if not ok then
			die("log file: " .. tostring(err))
		end
	end
	local dir = opts["dump-prompts"] or cfg.dump_prompts
	if dir then
		local ok, err = uv.fs_stat(dir)
		if not ok or ok.type ~= "directory" then
			die(("dump directory %s: %s"):format(dir, err or "not a directory"))
		end
		log.set_dump_dir(dir)
	end
end

-- The state directory: the flag, the config key, else
-- $XDG_STATE_HOME/lgml or ~/.local/state/lgml. nil when none is known.
local function state_dir(opts, cfg)
	local dir = opts["state-dir"] or cfg.state_dir
	if dir then
		return dir
	end
	local xdg, home = os.getenv("XDG_STATE_HOME"), os.getenv("HOME")
	if xdg and xdg ~= "" then
		return xdg .. "/lgml"
	elseif home and home ~= "" then
		return home .. "/.local/state/lgml"
	end
	return nil
end

-- The llama.cpp spellings -ngl and -ot, as long options.
local LLAMA_FLAGS = { ["-ngl"] = "--n-gpu-layers", ["-ot"] = "--override-tensor", ["-np"] = "--parallel",
	["-ub"] = "--ubatch" }

local function main(args)
	args = table.move(args, 1, #args, 1, {})
	for i, a in ipairs(args) do
		if a == "--" then
			break
		end
		args[i] = LLAMA_FLAGS[a] or a
	end
	local opts, rest = getopt.parse(args, "hvl:p:m:b:t:c:C:", {
		config = "C", help = "h", verbose = "v", ["log-level="] = false, ["log-file="] = false,
		["dump-prompts="] = false, listen = "l", port = "p", model = "m", backend = "b",
		threads = "t", ctx = "c", fake = false, ["no-fa"] = false, ["alias="] = false,
		inproc = false, stt = false, ["ctk="] = false, ["ctv="] = false, ["engine="] = false,
		["recipe="] = false, ["cache-ram="] = false, ["ctx-checkpoints="] = false,
		["kv-initial="] = false, ["parallel="] = false, ["repeat-stop="] = false,
		["reasoning-budget="] = false, ["ubatch="] = false,
		["spec="] = false, ["spec-mtp="] = false,
		["lora="] = false, ["cors="] = false, ["vram="] = false, ["idle="] = false,
		["mmproj="] = false, ["image-min-tokens="] = false, ["image-max-tokens="] = false,
		["text-backend="] = false, ["state-dir="] = false, ["unknown-fields="] = false,
		["cpu-moe"] = false, ["n-cpu-moe="] = false, ["n-gpu-layers="] = false,
		["override-tensor="] = false, ["moe-cache="] = false, ["moe-cache-profile="] = false,
	}, { lora = true, v = true, ["override-tensor"] = true })
	if not opts then
		io.stderr:write("lgml-server: ", rest, "\n", USAGE)
		os.exit(2)
	end
	if opts.h then
		io.stdout:write(USAGE)
		return
	end
	if #rest > 0 then
		io.stderr:write(USAGE)
		os.exit(2)
	end
	local cfg = opts.C and try(models.load, opts.C) or {}
	setup_log(opts, cfg)
	local sram = try(models.number, cfg, "state_ram")
	fdstore = require("lgml.server.fdstore").new({ ram = sram and math.floor(sram * MiB) })
	local engine = try(models.make, opts, cfg, { start = start_worker, devices = devices, names = state_names })
	fdstore:prune(state_names)
	local port = math.tointeger(tonumber(opts.p or cfg.port or 8080))
	if not port or port < 0 or port > 65535 then
		die("bad port " .. tostring(opts.p or cfg.port))
	end
	local srv = server.new({ cors = opts.cors or cfg.cors })
	local rule = opts["unknown-fields"] or cfg.unknown_fields
	if rule then
		if rule ~= "reject" and rule ~= "ignore" then
			die("unknown fields: reject or ignore, not " .. tostring(rule))
		end
		require("lgml.server.translate").set_unknown_fields(rule)
	end
	openai.install(srv, engine, { state_dir = state_dir(opts, cfg) })
	local bound, reused = srv:listen(opts.l or cfg.listen or "127.0.0.1", port, fdstore.listen)
	if not bound then
		if engine.stop then
			engine:stop()
		end
		die("listen: " .. tostring(reused))
	end
	L:info("listening", "addr", ("%s:%d"):format(srv.host, bound), "log_level", log.level_name(),
	    "kept", reused or nil)
	fdstore:keep_listen(srv:fileno())
	fdstore:ready()
	local has_lgml, lgml = pcall(require, "lgml")
	if has_lgml and lgml.set_proc_title then
		lgml.set_proc_title(("lgml-server %s:%d"):format(srv.host, bound), "lgml-server")
	end
	local sigs, stopping
	-- The workers save their prompt stores as they exit; wait for them.
	local function stop()
		if stopping then
			return
		end
		stopping = true
		if engine.stop then
			engine:stop()
		end
		srv:close()
		coroutine.wrap(function()
			require("lgml.server.remote_engine").wait_all(18000)
			for _, s in ipairs(sigs) do
				s:close()
			end
			uv.stop()
		end)()
	end
	sigs = {}
	for i, name in ipairs({ "sigint", "sigterm" }) do
		sigs[i] = uv.new_signal()
		sigs[i]:start(name, stop)
	end
	-- SIGHUP opens the log file again, here and in each worker.
	sigs[#sigs + 1] = uv.new_signal()
	sigs[#sigs]:start("sighup", function()
		local ok, err = log.reopen()
		if not ok then
			L:error("log file", "err", err)
		end
		require("lgml.server.remote_engine").signal("sighup")
	end)
	uv.run()
end

main(arg)
