#!/bin/sh
# lgml-repl: lua5.4 with lgml on the path and nd loaded as a global.
root=$(cd "$(dirname "$0")/.." && pwd)
LUA_PATH="$root/lua/?.lua;$root/lua/?/init.lua;$root/lua_modules/share/lua/5.4/?.lua;${LUA_PATH:-;}"
LUA_CPATH="$root/${LGML_BUILD:-build}/?.so;$root/lua_modules/lib/lua/5.4/?.so;${LUA_CPATH:-;}"
export LUA_PATH LUA_CPATH
exec lua5.4 -e 'nd = require("lgml.nd"); lgml = require("lgml")' -i "$@"
