Subject: [PATCH] vulkan: read pinned host tensors in place

ggml_backend_vk_set_host_read(true), found through the backend registry
proc address of the same name, lets ops on a Vulkan device read tensors
in its pinned host buffer type over PCIe, as on a UMA device, and the
scheduler keeps such ops on the device. lgml uses it for MoE experts that
no VRAM slot holds.

--- a/include/ggml-vulkan.h
+++ b/include/ggml-vulkan.h
@@ -42,6 +42,10 @@
 // fun as before. Register before the first graph that holds such an op.
 GGML_BACKEND_API void ggml_backend_vk_register_custom(ggml_custom_op_t fun, const struct ggml_vk_custom_op * op);
 
+// With on, ops on a Vulkan device read tensors in its pinned host buffer type
+// in place, over PCIe, and the scheduler keeps such ops on the device.
+GGML_BACKEND_API void ggml_backend_vk_set_host_read(bool on);
+
 #ifdef  __cplusplus
 }
 #endif
--- a/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/src/ggml-vulkan/ggml-vulkan.cpp
@@ -269,9 +269,17 @@
     return (uint8_t *) tensor->data - (uint8_t *) vk_ptr_base;
 }
 
+// When set, ops on the device read tensors in its pinned host buffer in place,
+// over PCIe, as on a UMA device. See ggml_backend_vk_set_host_read.
+static bool vk_host_read = false;
+
+void ggml_backend_vk_set_host_read(bool on) {
+    vk_host_read = on;
+}
+
 size_t ggml_vk_tensor_buffer_offset(const ggml_backend_vk_context * ctx, const ggml_tensor * t) {
     // vk_tensor_offset() is relative to vk_ptr_base, but mapped host tensors need an offset relative to their Vulkan buffer.
-    if (ctx->device->uma) {
+    if (ctx->device->uma || vk_host_read) {
         vk_buffer buf = nullptr;
         size_t off = 0;
         ggml_vk_host_get(ctx->device, t->data, buf, off);
@@ -5680,7 +5688,7 @@
 
     vk_buffer buffer = nullptr;
     size_t offset = 0;
-    if (ctx->device->uma) {
+    if (ctx->device->uma || vk_host_read) {
         ggml_vk_host_get(ctx->device, tensor->data, buffer, offset);
     }
     if (!buffer) {
@@ -6286,7 +6294,7 @@
     bool src0_uma = false;
     bool src1_uma = false;
 
-    if (ctx->device->uma) {
+    if (ctx->device->uma || vk_host_read) {
         ggml_vk_host_get(ctx->device, src0->data, d_Qx, qx_buf_offset);
         ggml_vk_host_get(ctx->device, src1->data, d_Qy, qy_buf_offset);
         src0_uma = d_Qx != nullptr;
@@ -7329,7 +7337,7 @@
     bool src1_uma = false;
     bool ids_uma = false;
 
-    if (ctx->device->uma) {
+    if (ctx->device->uma || vk_host_read) {
         ggml_vk_host_get(ctx->device, src0->data, d_Qx, qx_buf_offset);
         ggml_vk_host_get(ctx->device, src1->data, d_Qy, qy_buf_offset);
         ggml_vk_host_get(ctx->device, ids->data, d_ids, ids_buf_offset);
@@ -12255,11 +12263,18 @@
             if (unsynced_nodes.size() == 0) {
                 return false;
             }
+            // tensors in pinned host memory (vk_host_read) are read-only weights
+            if (node->buffer->buft->iface.get_name != ggml_backend_vk_buffer_type_name) {
+                return false;
+            }
             auto n_base = vk_tensor_offset(node) + node->view_offs;
             auto n_size = ggml_nbytes(node);
             ggml_backend_vk_buffer_context * a_buf_ctx = (ggml_backend_vk_buffer_context *)node->buffer->context;
             vk_buffer a_buf = a_buf_ctx->dev_buffer;
             for (auto &other : unsynced_nodes) {
+                if (other->buffer->buft->iface.get_name != ggml_backend_vk_buffer_type_name) {
+                    continue;
+                }
                 ggml_backend_vk_buffer_context * o_buf_ctx = (ggml_backend_vk_buffer_context *)other->buffer->context;
                 vk_buffer o_buf = o_buf_ctx->dev_buffer;
                 if (a_buf == o_buf) {
@@ -15975,6 +15990,9 @@
 }
 
 static bool ggml_backend_vk_device_supports_buft(ggml_backend_dev_t dev, ggml_backend_buffer_type_t buft) {
+    if (vk_host_read && buft == ggml_backend_vk_host_buffer_type()) {
+        return true;
+    }
     if (buft->iface.get_name != ggml_backend_vk_buffer_type_name) {
         return false;
     }
@@ -16153,6 +16171,9 @@
     if (strcmp(name, "ggml_backend_vk_register_custom") == 0) {
         return (void *) ggml_backend_vk_register_custom;
     }
+    if (strcmp(name, "ggml_backend_vk_set_host_read") == 0) {
+        return (void *) ggml_backend_vk_set_host_read;
+    }
     return NULL;
 }
 
