+// Pinned host memory that ops on the device read in place, over PCIe, as on a
+// UMA device. See ggml_backend_vk_host_read_buffer_type.
+static struct ggml_backend_buffer_type vk_host_read_buft;
+
+static bool ggml_vk_is_host_read(const ggml_tensor * t) {
+    return t != nullptr && t->buffer != nullptr && t->buffer->buft == &vk_host_read_buft;
+}
+
