+static const char * ggml_backend_vk_host_read_buffer_type_name(ggml_backend_buffer_type_t buft) {
+    return GGML_VK_NAME "_Host_Read";
+
+    UNUSED(buft);
+}
+
+ggml_backend_buffer_type_t ggml_backend_vk_host_read_buffer_type() {
+    static std::once_flag once;
+    std::call_once(once, [] {
+        vk_host_read_buft = *ggml_backend_vk_host_buffer_type();
+        vk_host_read_buft.iface.get_name = ggml_backend_vk_host_read_buffer_type_name;
+    });
+    return &vk_host_read_buft;
+}
