 }
 
+// Custom ops with a shader, see ggml_backend_vk_register_custom.
+static std::mutex vk_custom_mutex;
+static std::unordered_map<ggml_custom_op_t, ggml_vk_custom_op> vk_custom_ops;
+static std::map<std::pair<const vk_device_struct *, ggml_custom_op_t>, vk_pipeline> vk_custom_pipelines;
+
+void ggml_backend_vk_register_custom(ggml_custom_op_t fun, const struct ggml_vk_custom_op * op) {
+    std::lock_guard<std::mutex> guard(vk_custom_mutex);
+    vk_custom_ops[fun] = *op;
+}
+
+static const ggml_vk_custom_op * ggml_vk_custom_find(const ggml_tensor * node) {
+    if (node->op != GGML_OP_CUSTOM) {
+        return nullptr;
+    }
+    const auto * p = (const struct ggml_custom_op_params *) node->op_params;
+    std::lock_guard<std::mutex> guard(vk_custom_mutex);
+    auto it = vk_custom_ops.find(p->fun);
+    return it == vk_custom_ops.end() ? nullptr : &it->second;
+}
+
+static void ggml_vk_custom(ggml_backend_vk_context * ctx, vk_context & subctx, ggml_tensor * node) {
+    const ggml_vk_custom_op * op = ggml_vk_custom_find(node);
+    GGML_ASSERT(op != nullptr);
+    const auto * p = (const struct ggml_custom_op_params *) node->op_params;
+
+    uint32_t n_src = 0;
+    while (n_src < GGML_MAX_SRC && node->src[n_src] != nullptr) {
+        n_src++;
+    }
+    const uint32_t n_bind = n_src + 1;
+    GGML_ASSERT(n_bind <= 8 && op->push_size % 4 == 0);
+
+    vk_pipeline pipeline;
+    {
+        std::lock_guard<std::mutex> guard(vk_custom_mutex);
+        vk_pipeline & pl = vk_custom_pipelines[{ ctx->device.get(), p->fun }];
+        if (!pl) {
+            pl = std::make_shared<vk_pipeline_struct>();
+            pl->name = "custom";
+            pl->parameter_count = n_bind;
+            pl->push_constant_size = op->push_size + 4 * n_bind;
+            pl->wg_denoms = { op->wg_denoms[0], op->wg_denoms[1], op->wg_denoms[2] };
+            pl->align = 1;
+            pl->initialized = true;
+            ggml_vk_create_pipeline_func(ctx->device, pl, op->spv_size, op->spv, "main", n_bind,
+                                         pl->wg_denoms, {}, false, false, 0);
+        }
+        GGML_ASSERT(pl->parameter_count == n_bind);
+        pipeline = pl;
+    }
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    std::vector<uint32_t> push(op->push_size / 4 + n_bind, 0);
+    uint32_t elements[3] = { 1, 1, 1 };
+    op->setup(node, push.data(), elements);
+
+    vk_subbuffer b[8];
+    for (uint32_t i = 0; i < n_bind; i++) {
+        const ggml_tensor * t = i < n_src ? node->src[i] : node;
+        b[i] = ggml_vk_tensor_subbuffer(ctx, t, true);
+        push[op->push_size / 4 + i] = (uint32_t) (ggml_vk_tensor_buffer_offset(ctx, t) - b[i].offset);
+    }
+    const std::array<uint32_t, 3> el = { elements[0], elements[1], elements[2] };
+    switch (n_bind) {
+        case 1: ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { b[0] }, push, el); break;
+        case 2: ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { b[0], b[1] }, push, el); break;
+        case 3: ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { b[0], b[1], b[2] }, push, el); break;
+        case 4: ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { b[0], b[1], b[2], b[3] }, push, el); break;
+        case 5: ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { b[0], b[1], b[2], b[3], b[4] }, push, el); break;
+        case 6: ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { b[0], b[1], b[2], b[3], b[4], b[5] }, push, el); break;
+        case 7: ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { b[0], b[1], b[2], b[3], b[4], b[5], b[6] }, push, el); break;
+        default: ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7] }, push, el); break;
+    }
+}
