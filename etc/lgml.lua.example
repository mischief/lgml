-- lgml-server -C etc/lgml.lua
-- Each model runs in its own worker process. A worker starts on the
-- first request for its model, or at startup with preload = true.
-- Requests pick a model by the "model" field; an unknown or missing
-- model goes to the first one that can serve the request.
return {
	listen = "127.0.0.1",
	port = 8091,
	-- GPU memory for models, in MiB (default: the free GPU memory at
	-- startup minus 1024). A load that does not fit unloads idle models,
	-- least recently used first.
	vram = 20000,
	-- Host memory for models on the CPU and the host part of GPU models,
	-- in MiB (default: no limit).
	-- ram = 32000,
	-- Unload a model after this many seconds without requests (default
	-- 0: never).
	idle = 300,
	-- The most seconds a load waits for requests of other models to end,
	-- when it needs their memory (default 60).
	load_wait = 60,
	-- CPU threads of each model (default: the LGML_THREADS environment
	-- variable, else the physical cores). A model spec can set its own.
	threads = 16,
	-- Log level: error, warn, info, debug or trace (default: LGML_LOG, else
	-- info). -v and --log-level override it. debug shows each prompt as the
	-- model sees it.
	-- log_level = "debug",
	-- Append log lines to this file, not stderr; SIGHUP opens it again.
	-- log_file = "/home/you/lgml.log",
	-- Write each rendered chat and decision prompt to this directory, in
	-- files named by request id.
	-- dump_prompts = "/home/you/prompts",
	models = {
		-- lora adds LoRA adapters, "file[:scale]", from lgml-finetune or
		-- llama.cpp; a request can change their scales.
		{ id = "qwen3-14b", model = "/home/you/models/Qwen3-14B-Q4_K_M.gguf", backend = "Vulkan0",
			preload = true, ctx = 16384,
			-- lora = { "/home/you/adapters/tuned.gguf:1.0" },
		},
		-- mmproj adds image input: image_url parts with data URLs. slots
		-- keeps a KV cache per client on the device (each starts at
		-- kv_initial rows and grows to ctx).
		{ id = "gemma-4-26b", model = "/home/you/models/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf",
			mmproj = "/home/you/models/gemma-4-26B-A4B-it-mmproj-F16.gguf", backend = "Vulkan0",
			ctx = 16384, slots = 2 },
		-- n_cpu_moe keeps the routed experts of the first N layers in host
		-- memory, where the CPU runs them; "auto" picks the fewest layers
		-- that fit vram. That part counts against ram. cpu_moe = true
		-- takes the experts of every layer, n_gpu_layers keeps only the
		-- last N layers on the GPU, and override = { "pattern=CPU", ... }
		-- places tensors by Lua pattern.
		{ id = "qwen3.5-35b", model = "/home/you/models/Qwen3.5-35B-A3B-Q4_K_M.gguf",
			backend = "Vulkan0", ctx = 32768, n_cpu_moe = "auto" },
		-- idle = 0 keeps this model loaded until another load needs room.
		{ id = "whisper", model = "/home/you/models/whisper-large-v3-turbo", backend = "Vulkan0",
			idle = 0 },
		-- mem sets the MiB a model takes, in place of the estimate.
		-- text_backend = "CPU" keeps the text encoder (4 GiB) out of GPU
		-- memory; it counts against ram, and mem counts the GPU part: about
		-- 7.5 GiB at 512x512 and 9.6 GiB at 1024x1024.
		{ id = "zimage", model = "/home/you/models/zimage", engine = "lgml.image.engine",
			backend = "Vulkan0", text_backend = "CPU", mem = 10000 },
		{ id = "orpheus", model = "/home/you/models/orpheus", engine = "lgml.tts.orpheus" },
		{ id = "qwen3-tts", model = "/home/you/models/qwen3-tts", engine = "lgml.tts.qwen3tts" },
		-- Models on the CPU do not count against vram.
		{ id = "vibevoice", model = "/home/you/models/vibevoice-realtime-0.5b", engine = "lgml.tts.vibevoice",
			backend = "CPU", threads = 8 },
	},
}
