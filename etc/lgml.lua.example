-- lgml-server -C etc/lgml.lua
-- Each model runs in its own worker process. A worker starts on the
-- first request for its model, or at startup with preload = true.
-- Requests pick a model by the "model" field; an unknown or missing
-- model goes to the first one that can serve the request.
return {
	listen = "127.0.0.1",
	port = 8091,
	-- GPU memory for models, in MiB (default: the free GPU memory at
	-- startup minus 1024). A load that does not fit unloads idle models,
	-- least recently used first.
	vram = 20000,
	-- Host memory for models on the CPU and the host part of GPU models,
	-- in MiB (default: no limit).
	-- ram = 32000,
	-- Unload a model after this many seconds without requests (default
	-- 0: never).
	idle = 300,
	-- The most seconds a load waits for requests of other models to end,
	-- when it needs their memory (default 60).
	load_wait = 60,
	-- Device memory in MiB that each worker leaves free (default 256). A
	-- load or a prompt that would pass it gets status 507.
	-- mem_margin = 256,
	-- A reply that samples one token this many times in a row ends with
	-- finish reason length (default 256; 0 turns the guard off). A model
	-- spec can set its own.
	-- repeat_stop_tokens = 256,
	-- CPU threads of each model (default: the LGML_THREADS environment
	-- variable, else the physical cores). A model spec can set its own.
	threads = 16,
	-- Log level: error, warn, info, debug or trace (default: LGML_LOG, else
	-- info). -v and --log-level override it. debug shows each prompt as the
	-- model sees it.
	-- log_level = "debug",
	-- Append log lines to this file, not stderr; SIGHUP opens it again.
	-- log_file = "/home/you/lgml.log",
	-- Write each rendered chat and decision prompt to this directory, in
	-- files named by request id.
	-- dump_prompts = "/home/you/prompts",
	models = {
		-- lora adds LoRA adapters, "file[:scale]", from lgml-finetune or
		-- llama.cpp; a request can change their scales. sampling sets
		-- sampler defaults that a request value replaces.
		-- ubatch is the most prompt tokens per pass (default 512); "auto"
		-- takes the largest of 4096, 2048, 1024 and 512 whose compute
		-- buffers fit vram at load. Larger chunks read long prompts faster.
		{ id = "qwen3-14b", model = "/home/you/models/Qwen3-14B-Q4_K_M.gguf", backend = "Vulkan0",
			preload = true, ctx = 16384, ubatch = "auto",
			-- lora = { "/home/you/adapters/tuned.gguf:1.0" },
			-- sampling = { presence_penalty = 1.5 },
		},
		-- mmproj adds image input: image_url parts with data URLs. slots
		-- is the most sequences kept, such as one per client (default 4, or
		-- fewer when their rings or recurrent states would take more than a
		-- quarter of the pool).
		-- They share one KV pool of ctx cells, which starts at kv_initial
		-- cells and grows to ctx. cache_ram is the host RAM in MiB for
		-- stored prefixes and checkpoints (default 8192). A gemma
		-- checkpoint is about 55 MiB, so the default fills in minutes.
		-- reasoning_budget_tokens is the reasoning budget of a request that
		-- sets none: after that many reasoning tokens the engine ends the
		-- block and the model answers.
		{ id = "gemma-4-26b", model = "/home/you/models/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf",
			mmproj = "/home/you/models/gemma-4-26B-A4B-it-mmproj-F16.gguf", backend = "Vulkan0",
			ctx = 16384, slots = 2, cache_ram = 2048, reasoning_budget_tokens = 4096 },
		-- recipe sets the /v1/systemone format: "jevify" (the default),
		-- "nimble" (Ollama's format, for Bespoke-Nimble), or a Jevify
		-- recipe.json file. The Ollama blob of nimble is a gguf.
		{ id = "nimble", model = "/home/you/models/Bespoke-Nimble-9B-Q8_0.gguf",
			backend = "Vulkan0", ctx = 8192, recipe = "nimble", cache_ram = 2048 },
		-- n_cpu_moe keeps the routed experts of the first N layers in host
		-- memory, where the CPU runs them; "auto" picks the fewest layers
		-- that fit vram. That part counts against ram. cpu_moe = true
		-- takes the experts of every layer, n_gpu_layers keeps only the
		-- last N layers on the GPU, and override = { "pattern=CPU", ... }
		-- places tensors by Lua pattern.
		{ id = "qwen3.5-35b", model = "/home/you/models/Qwen3.5-35B-A3B-Q4_K_M.gguf",
			backend = "Vulkan0", ctx = 32768, n_cpu_moe = "auto" },
		-- moe_cache keeps every routed expert in host memory and the most
		-- used ones in a vram cache that adapts as the model runs: MiB, or
		-- "auto" for the vram left after the KV cache, at most
		-- moe_cache_max MiB. moe_cache_profile seeds it from a profile.
		-- { id = "gemma-4-26b", model = "/home/you/models/gemma-4-26B-A4B-Q4_K_M.gguf",
		-- 	backend = "Vulkan0", ctx = 32768, moe_cache = "auto", moe_cache_max = 8192 },
		-- idle = 0 keeps this model loaded until another load needs room.
		{ id = "whisper", model = "/home/you/models/whisper-large-v3-turbo", backend = "Vulkan0",
			idle = 0 },
		-- A gguf with a pooling type, such as Qwen3-Embedding, serves
		-- /v1/embeddings and not chat. ctx is the longest input.
		-- { id = "qwen3-embedding-4b", model = "/home/you/models/Qwen3-Embedding-4B-Q8_0.gguf",
		-- 	backend = "Vulkan0", ctx = 8192 },
		-- text_backend = "CPU" keeps the text encoder (4 GiB) out of GPU
		-- memory; it counts against ram. The worker plans the GPU part
		-- for image_max_side (default 1024): about 9.6 GiB at 1024x1024.
		-- mem = MiB would set the count in place of the measure.
		{ id = "zimage", model = "/home/you/models/zimage", engine = "lgml.image.engine",
			backend = "Vulkan0", text_backend = "CPU" },
		-- A block diffusion chat model. diffusion sets the sampler
		-- defaults; prefix_cache trades exactness for speed on long prompts.
		{ id = "llada", model = "/home/you/models/LLaDA-MoE-v2-30B-A3B-Instruct-Q4_K_M.gguf",
			backend = "Vulkan0", ctx = 8192, diffusion = { prefix_cache = false } },
		{ id = "orpheus", model = "/home/you/models/orpheus", engine = "lgml.tts.orpheus" },
		{ id = "qwen3-tts", model = "/home/you/models/qwen3-tts", engine = "lgml.tts.qwen3tts" },
		-- Models on the CPU do not count against vram.
		{ id = "vibevoice", model = "/home/you/models/vibevoice-realtime-0.5b", engine = "lgml.tts.vibevoice",
			backend = "CPU", threads = 8 },
	},
}
