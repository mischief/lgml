#version 450
// hc_mean: d[t][e] = sum over h of x[t][h][e] * sigmoid(g[t][h][e]).
// One invocation per element of d: x is e, y is t.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer G { float g[]; };
layout(binding = 2) writeonly buffer D { float d[]; };

layout(push_constant) uniform P {
	uint E;
	uint HC;
	uint T;
	uint off_x;
	uint off_g;
	uint off_d;
} p;

void main()
{
	const uint e = gl_GlobalInvocationID.x;
	const uint t = gl_GlobalInvocationID.y;
	if (e >= p.E || t >= p.T) {
		return;
	}
	float s = 0.0;
	for (uint h = 0; h < p.HC; h++) {
		const uint i = (t * p.HC + h) * p.E + e;
		s += x[p.off_x / 4 + i] / (1.0 + exp(-g[p.off_g / 4 + i]));
	}
	d[p.off_d / 4 + t * p.E + e] = s;
}
