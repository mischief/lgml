option('model', type : 'string', value : '',
  description : 'gguf model for model tests; empty skips them')
option('whisper', type : 'string', value : '',
  description : 'Whisper model directory (safetensors) for whisper tests; empty skips them')
option('whisper_wav', type : 'string', value : '',
  description : 'speech WAV (jfk.wav) for whisper transcript tests')
option('orpheus', type : 'string', value : '',
  description : 'Orpheus model directory for TTS tests; empty skips them')
option('qwen3tts', type : 'string', value : '',
  description : 'Qwen3-TTS model directory for TTS tests; empty skips them')
option('vibevoice', type : 'string', value : '',
  description : 'VibeVoice model directory for TTS tests; empty skips them')
option('vocab_dir', type : 'string', value : '',
  description : 'llama.cpp vocab test directory (ggml-vocab-*.gguf, .inp, .out); empty skips them')
option('tok_gemma4', type : 'string', value : '',
  description : 'Gemma-4 gguf for tokenizer special token tests (reads metadata only); empty skips them')
option('ggml', type : 'combo', choices : ['auto', 'system', 'subproject'], value : 'subproject',
  description : 'ggml built from subprojects/ggml.wrap (static, with the lgml patch), or the system one; auto: the system one when found')
option('lua_dir', type : 'string', value : '',
  description : 'install directory of the Lua modules; empty: <prefix>/share/lua/5.4')
option('lua_cdir', type : 'string', value : '',
  description : 'install directory of the C module; empty: <prefix>/lib/lua/5.4')
option('ngram', type : 'string', value : '',
  description : 'gguf file with a PLE n-gram table (per_layer_token_embd.weight) for the ngram test; empty skips that check')
option('ngram_meta', type : 'string', value : '',
  description : 'gguf file with the ple keys of the ngram table, when another file holds them')
